NODE_ENV=development
DATA_MODE=local
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
# Optional: absolute API origin for separate same-site frontend/API deployments.
# Leave blank to use same-origin /api routing (recommended).
VITE_API_URL=
# Optional Vite development proxy target; defaults to http://localhost:4000.
API_PROXY_TARGET=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_campus_assistant
JWT_SECRET=replace-with-a-random-secret-at-least-43-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
MAX_UPLOAD_MB=15
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=campus_documents
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RAG_MAX_DISTANCE=0.45
